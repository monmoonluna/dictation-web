# Copy to .env before running `docker compose up`.
# This file feeds docker-compose AND is mounted as env_file into api/worker,
# so it must hold every variable the backend reads.

# =========================
# PORTS ON THE HOST
# =========================
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# =========================
# POSTGRESQL
# =========================
POSTGRES_DB=dictation_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_this_password

# =========================
# APPLICATION
# =========================
APP_NAME=Dictation Web
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# =========================
# SECURITY
# =========================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================
# MEDIA STORAGE
# =========================
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=./storage/media
MAX_UPLOAD_SIZE_MB=50

# =========================
# TRANSCRIPTION
# =========================
TRANSCRIBER_PROVIDER=whisper
TRANSCRIBER_MODEL=base
TRANSCRIBER_LANGUAGE=vi

# =========================
# FRONTEND BUILD (baked into the bundle at build time)
# =========================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

# NOTE: DATABASE_URL and REDIS_URL are set by docker-compose from the values
# above. Only set them here when running the backend outside Docker.
